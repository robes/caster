# --- General ---
.DS_Store

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env

# --- Caches & tooling ---
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.mypy_cache/

# --- Hydra / runs ---
# Run directories are reproducible from code + data + seed; the bulk of one is
# checkpoints, and the canonical ones are already a DVC out of the train stage.
# (If you choose to DVC-track a whole run, its .dvc pointer is committed and the
#  bytes go to the DVC remote — the directory itself still stays gitignored.)
#
# The run-stamps are the exception, and are committed. docs/PROVENANCE.md calls
# them the durable record — commit, environment and stats per run — while the
# experiment ledger is a regenerable view over them. Ignoring them would make
# `rm -rf outputs/` destroy the run history and the ledger with it, for the sake
# of a few KB. Same pattern as the DVC section below: `**` rather than a bare
# directory, because git will not descend into an excluded directory, so the
# directories must be re-admitted before a file inside them can be.
outputs/**
!outputs/**/
!outputs/**/_provenance.json
# multirun/ is not re-admitted: `caster provenance ledger` scans outputs/ only.
multirun/

# --- Releases ---
releases/

# --- DVC-managed data ---
# The bytes are tracked by DVC (cache + remote), not git. The committed
# artifacts are the *.dvc pointer files and dvc.lock, which are NOT ignored.
/data/raw/*
/data/processed/*
/data/features/*
# ...but keep the directory structure and the DVC pointer files:
!/data/raw/.gitkeep
!/data/processed/.gitkeep
!/data/raw/*.dvc
!/data/processed/*.dvc
!/data/features/*.dvc

# --- DVC internals ---
/.dvc/cache
/.dvc/tmp
/.dvc/config.local

# --- Reports (commit deliberately if you want them in history) ---
reports/*.pdf
